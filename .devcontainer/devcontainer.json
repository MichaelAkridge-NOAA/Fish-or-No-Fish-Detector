// .devcontainer/devcontainer.json
{
  "name": "Fish – Codespace ",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  // ONE shell line, using && between commands
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y xvfb fluxbox x11vnc novnc websockify && pip install -r .devcontainer/yes-no-fish/requirements.txt",

  "postStartCommand": "chmod +x .devcontainer/start-xvnc.sh && /bin/bash .devcontainer/start-xvnc.sh",

  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  },

  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Fish",
      "onAutoForward": "openPreview",
      "visibility": "public",
      "protocol": "http",
      "path": "/vnc.html?autoconnect=1"
    }
  }
}
